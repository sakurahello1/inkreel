# ---- 图片 / 视频走哪家 ----
# fal：便宜、快（gpt-image-2.5 flare + MiniMax H3 Max Turbo）；relay：OpenAI 兼容的中转站
IMAGE_PROVIDER=fal
VIDEO_PROVIDER=fal
FAL_KEY=
# gpt-image-2.5 推理等级默认：low | medium | high | xhigh | max（项目设置里可改，每镜可覆盖）
FAL_IMAGE_QUALITY=low
# FAL_VIDEO_MODEL=minimax/h3-max-turbo
# FAL_VIDEO_REF_MODEL=minimax/h3-max
# FAL_ASR_MODEL=fal-ai/whisper

# ---- 中转站（OpenAI 兼容接口）----
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=gpt-5.6-sol
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL_T2V=hailuo-h3
VIDEO_MODEL_I2V=hailuo-h3-shouweizhen
VIDEO_MODEL_REF=hailuo-h3-quannengcankao
VIDEO_RESOLUTION=768P

# ---- MiniMax（音色克隆、ASR）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com

# ---- 数据 ----
# 数据库与生成文件放在项目目录外，避免开发模式下被文件监听触发热刷新
DATABASE_URL=file:../../short-play-data/app.db
STORAGE_DIR=../short-play-data/storage
# 进程内任务队列并发
JOB_CONCURRENCY=8

# ---- ffmpeg ----
FFMPEG_PATH=
FFPROBE_PATH=
SUBTITLE_FONT=Noto Sans CJK SC

# ---- 访问控制（公网部署必填；本机留空即不启用）----
APP_PASSWORD=
AUTH_SECRET=
# 对外访问地址，需要公网 URL 的功能（参考视频）用
PUBLIC_BASE_URL=

# ---- 出图尺寸（默认按 2K；首帧尺寸由项目画幅决定，不要在这里覆盖）----
SHEET_SIZE=3072x2048
PROP_SIZE=2048x2048
